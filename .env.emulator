# Valori FINTI per sviluppo e test sugli emulatori Firebase (vite --mode emulator).
# Il prefisso demo- garantisce che nessuna chiamata raggiunga un progetto reale.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-bagna-halloween.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-bagna-halloween
VITE_FIREBASE_STORAGE_BUCKET=demo-bagna-halloween.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_ADMIN_ROUTE=/admin
VITE_MAP_IMAGE=/mappa-segnaposto.svg
